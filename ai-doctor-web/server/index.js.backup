// Remove duplicate doctors based on name and clinic
function removeDuplicateDoctors(doctors) {
  const seen = new Set();
  return doctors.filter(doctor => {
    const key = `${doctor.name}-${doctor.clinic}`;
    if (seen.has(key)) {
      return false;
    }
    seen.add(key);
    return true;
  });
}


