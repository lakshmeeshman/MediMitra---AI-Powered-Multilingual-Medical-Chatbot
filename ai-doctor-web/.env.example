# Environment Variables for AI Doctor Web Application

# Groq API Key for LLM responses
GROQ_API_KEY=your_groq_api_key_here

# Google Cloud TTS Service Account (JSON file path)
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/ai-doctor

# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# D-ID API Key for Avatar
DID_API_KEY=your_did_api_key

# Hugging Face Token (if using HF models)
HUGGINGFACE_TOKEN=your_hf_token

# Server Port
PORT=5051

# Client Port
CLIENT_PORT=3002
